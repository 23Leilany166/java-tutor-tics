digraph DiagramaFlujo {
  node [shape=box]

  Inicio [shape=ellipse ,label="Inicio"]
  IngresoCalle [label="  calle"]
  LeerCalle [label="Leer calle"]
  IngresoNumero [label=" número"]
  LeerNumero [label="Leer número"]
  IngresoCiudad [label=" ciudad"]
  LeerCiudad [label="Leer ciudad"]
  IngresoPais [label=" país"]
  LeerPais [label="Leer país"]
  ImprimirCalle [label="Imprimir calle"]
  ImprimirNumero [label="Imprimir número"]
  ImprimirCiudad [label="Imprimir ciudad"]
  ImprimirPais [label="Imprimir país"]
  Fin [shape=ellipse ,label="Fin"]
  
  Inicio -> IngresoCalle
  IngresoCalle -> LeerCalle
  LeerCalle -> IngresoNumero
  IngresoNumero -> LeerNumero
  LeerNumero -> IngresoCiudad
  IngresoCiudad -> LeerCiudad
  LeerCiudad -> IngresoPais
  IngresoPais -> LeerPais
  LeerPais -> ImprimirCalle

  ImprimirCalle -> ImprimirNumero
  ImprimirNumero -> ImprimirCiudad
  ImprimirCiudad -> ImprimirPais
  ImprimirPais -> Fin
}
