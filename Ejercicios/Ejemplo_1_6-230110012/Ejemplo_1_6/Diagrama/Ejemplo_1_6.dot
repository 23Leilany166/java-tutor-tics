/* EJEMPLO 1.6 - Invertir orden de 4 números */
digraph Ejemplo_1_6 {
    bgcolor=none
    rankdir=TB
    node [shape=box, style="filled", fillcolor="white", color="black", fontname="Arial"]
    edge [color="black", fontname="Arial"]
    
    start [shape=ellipse, label="INICIO"]
    input1 [shape=parallelogram, label="Leer A, B, C, D"]
    output [shape=egg, label="D, C, B, A"]
    end [shape=ellipse, label="FIN"]
    
    start -> input1
    input1 -> output
    output -> end
}