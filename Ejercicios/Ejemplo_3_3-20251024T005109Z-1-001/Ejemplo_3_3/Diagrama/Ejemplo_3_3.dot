digraph Ejemplo_3_3_Diagrama {
    node [shape=box];
    start [label="Inicio", shape=ellipse, fillcolor="#40e0d0", style="filled"];
    input [label="Ingrese la cantidad de números:", shape=diamond];
    N [label="N = Leer entrada", shape=box];
    CUECER [label="CUECER = 0", shape=box];
    I [label="I = 1", shape=box];
    loop [label="¿I <= N?", shape=diamond];
    input_num [label="Ingrese el número #I:", shape=diamond];
    check_zero [label="¿NUM == 0?", shape=diamond];
    increment_cuecer [label="CUECER++", shape=box];
    increment_i [label="I++", shape=box];
    output [label="Mostrar Cantidad de ceros encontrados: CUECER", shape=diamond];
    end [label="Fin", shape=ellipse, fillcolor="#40e0d0", style="filled"];

    start -> input;
    input -> N;
    N -> CUECER;
    CUECER -> I;
    I -> loop;
    loop -> input_num [label="Sí"];
    loop -> output [label="No"];
    input_num -> check_zero;
    check_zero -> increment_cuecer [label="Sí"];
    check_zero -> increment_i [label="No"];
    increment_cuecer -> increment_i;
    increment_i -> loop;
    output -> end;
}
