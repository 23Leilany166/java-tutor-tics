digraph PS_3_24_Diagrama {
    node [shape=box];
    start [label="Inicio", shape=ellipse, fillcolor="#40e0d0", style="filled"];
    init_variables [label="Inicializar variables", shape=box];
    loop_start1 [label="Para i = 1 hasta 3", shape=diamond];
    input_matricula [label="Leer matrícula", shape=box];
    init_suma [label="Inicializar suma de calificaciones", shape=box];
    loop_start2 [label="Para j = 1 hasta 5", shape=diamond];
    input_calificacion [label="Leer calificación", shape=box];
    update_suma [label="Actualizar suma", shape=box];
    calculate_promedio [label="Calcular promedio", shape=box];
    check_mejor_promedio [label="¿Promedio > mejorPromedio?", shape=diamond];
    update_mejor_promedio [label="Actualizar mejorPromedio", shape=box];
    check_peor_promedio [label="¿Promedio < peorPromedio?", shape=diamond];
    update_peor_promedio [label="Actualizar peorPromedio", shape=box];
    increment_j [label="j++", shape=box];
    loop_end2 [label="Fin del ciclo", shape=ellipse, fillcolor="#40e0d0", style="filled"];
    increment_i [label="i++", shape=box];
    loop_end1 [label="Fin del ciclo", shape=ellipse, fillcolor="#40e0d0", style="filled"];
    output_result [label="Mostrar resultados", shape=diamond];
    end [label="Fin", shape=ellipse, fillcolor="#40e0d0", style="filled"];

    start -> init_variables;
    init_variables -> loop_start1;
    loop_start1 -> input_matricula;
    input_matricula -> init_suma;
    init_suma -> loop_start2;
    loop_start2 -> input_calificacion;
    input_calificacion -> update_suma;
    update_suma -> loop_end2 [label="No"];
    loop_end2 -> calculate_promedio;
    calculate_promedio -> check_mejor_promedio;
    check_mejor_promedio -> update_mejor_promedio [label="Sí"];
    check_mejor_promedio -> check_peor_promedio [label="No"];
    update_mejor_promedio -> check_peor_promedio;
    check_peor_promedio -> update_peor_promedio [label="Sí"];
    check_peor_promedio -> increment_j [label="No"];
    update_peor_promedio -> increment_j;
    increment_j -> loop_start2;
    loop_start2 -> loop_end1 [label="No"];
    loop_end1 -> output_result;
    output_result -> end;
}
