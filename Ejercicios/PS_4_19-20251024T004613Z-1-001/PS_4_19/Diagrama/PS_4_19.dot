digraph G {
    inicio [shape=ellipse,label="Inicio"];
    ciclo_alumnos [shape=diamond,label="i < 30"];
    ciclo_examenes [shape=diamond,label="j < 6"];
    leer_calificacion [shape=box,label="Leer calificaciones[i][j]"];
    incrementar_j [shape=box,label="Incrementar j"];
    incrementar_i [shape=box,label="Incrementar i"];
    calcular_promedios_examenes [shape=box,label="Calcular promedios de examenes"];
    calcular_promedios_alumnos [shape=box,label="Calcular promedios de alumnos"];
    buscar_mayor_promedio [shape=box,label="Buscar mayor promedio"];
    imprimir_promedios_examenes [shape=box,label="Imprimir promedios de examenes"];
    imprimir_promedios_alumnos [shape=box,label="Imprimir promedios de alumnos"];
    imprimir_mayor_promedio [shape=box,label="Imprimir mayor promedio"];
    fin [shape=ellipse,label="Fin"];

    inicio -> ciclo_alumnos;
    ciclo_alumnos -> ciclo_examenes [label="Sí"];
    ciclo_examenes -> leer_calificacion [label="Sí"];
    leer_calificacion -> incrementar_j;
    incrementar_j -> ciclo_examenes;
    ciclo_examenes -> incrementar_i [label="No"];
    incrementar_i -> ciclo_alumnos;
    ciclo_alumnos -> calcular_promedios_examenes [label="No"];
    calcular_promedios_examenes -> calcular_promedios_alumnos;
    calcular_promedios_alumnos -> buscar_mayor_promedio;
    buscar_mayor_promedio -> imprimir_promedios_examenes;
    imprimir_promedios_examenes -> imprimir_promedios_alumnos;
    imprimir_promedios_alumnos -> imprimir_mayor_promedio;
    imprimir_mayor_promedio -> fin;
}
