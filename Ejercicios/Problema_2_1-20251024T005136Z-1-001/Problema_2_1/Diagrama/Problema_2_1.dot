digraph Problema2_1_Diagrama {
    node [shape=box];
    start [label="Inicio", shape=ellipse, fillcolor="#40e0d0", style="filled"];
    input [label="Ingrese el número de sonidos emitidos por minuto:", shape=diamond];
    N [label="N = Leer entrada", shape=box];
    condition [label="¿N > 0?", shape=diamond];
    calculate [label="T = N / 4.0 + 40", shape=box];
    output [label="Mostrar Temperatura: T", shape=diamond];
    end [label="Fin", shape=ellipse, fillcolor="#40e0d0", style="filled"];

    start -> input;
    input -> N;
    N -> condition;
    condition -> calculate [label="Sí"];
    condition -> output [label="No"];
    calculate -> output;
    output -> end;
}
