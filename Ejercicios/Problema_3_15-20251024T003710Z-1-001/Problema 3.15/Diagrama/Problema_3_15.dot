digraph Flowchart_Problema_3_15 {
    // --- Configuración Global ---
    graph [fontname = "Arial"];
    node [fontname = "Arial", style="filled", fillcolor="#EFEFEF"]; // Estilo de nodo por defecto
    edge [fontname = "Arial"];
    
    // Nodos con forma de diamante (condiciones)
    node [shape=diamond, fillcolor="#FFFFFF"]; 
    Loop_Cond; Cond_TIPO; Cond_DUR_I; Cond_CL; Cond_DUR_N;
    
    // Nodos con forma de óvalo (inicio/fin)
    node [shape=ellipse, fillcolor="#EFEFEF"]; 
    Inicio; Fin;
    
    // Nodos con forma de paralelogramo (entrada/salida)
    node [shape=parallelogram]; 
    Leer_Datos_1; Leer_Datos_2; Mostrar_Cuenta;
    
    // Nodos con forma de caja (procesos)
    node [shape=box]; 
    Inicializacion; Costo_I_Largo; Costo_I_Corto; Inc_CL;
    Costo_L_Cargo; Costo_L_SinCargo; Costo_N_Largo; Costo_N_Corto;
    Actualizar_Cuenta;

    // --- Definición de Etiquetas (Labels) ---
    Inicio [label="INICIO"];
    Inicializacion [label="CL <- 0\nCUENTA <- 0"];
    Leer_Datos_1 [label="TIPO, DUR"];
    Loop_Cond [label="(TIPO <> 'X')\ny (DUR <> -1)"];
    
    Mostrar_Cuenta [label="CUENTA"];
    Fin [label="FIN"];

    Cond_TIPO [label="TIPO"]; 
    
    // Branch 'I'
    Cond_DUR_I [label="DUR > 3"];
    Costo_I_Largo [label="COSTO <- 7.59 + (DUR-3)\n* 3.03"];
    Costo_I_Corto [label="COSTO <- 7.59"];

    // Branch 'L'
    Inc_CL [label="CL <- CL + 1"];
    Cond_CL [label="CL > 50"];
    Costo_L_Cargo [label="COSTO <- 0.60"];
    Costo_L_SinCargo [label="COSTO <- 0"]; // Como se muestra en la imagen

    // Branch 'N'
    Cond_DUR_N [label="DUR > 3"];
    Costo_N_Largo [label="COSTO <- 1.20 + (DUR-3)\n* 0.48"];
    Costo_N_Corto [label="COSTO <- 1.20"];

    // Nodos de Fin de Bucle
    Actualizar_Cuenta [label="CUENTA <- CUENTA + COSTO"];
    Leer_Datos_2 [label="TIPO, DUR"];
    
    // --- Conexiones (Flujo) ---
    
    // Flujo principal
    Inicio -> Inicializacion -> Leer_Datos_1 -> Loop_Cond;

    // Salida del bucle (rama "No")
    Loop_Cond -> Mostrar_Cuenta [label=" No"]; 
    Mostrar_Cuenta -> Fin;
    
    // Entrada al bucle (rama "Si")
    Loop_Cond -> Cond_TIPO [label=" Si"]; 

    // --- Ramas del "Switch" TIPO ---
    Cond_TIPO -> Cond_DUR_I [label=" 'I'"];
    Cond_TIPO -> Inc_CL [label=" 'L'"]; // La rama 'L' empieza con CL+1
    Cond_TIPO -> Cond_DUR_N [label=" 'N'"];
    
    // --- Flujo Branch 'I' ---
    Cond_DUR_I -> Costo_I_Largo [label="Si"];
    Cond_DUR_I -> Costo_I_Corto [label="No"];
    Costo_I_Largo -> Actualizar_Cuenta;
    Costo_I_Corto -> Actualizar_Cuenta;

    // --- Flujo Branch 'L' ---
    Inc_CL -> Cond_CL;
    Cond_CL -> Costo_L_Cargo [label="Si"];
    Cond_CL -> Costo_L_SinCargo [label="No"];
    Costo_L_Cargo -> Actualizar_Cuenta;
    Costo_L_SinCargo -> Actualizar_Cuenta;

    // --- Flujo Branch 'N' ---
    Cond_DUR_N -> Costo_N_Largo [label="Si"];
    Cond_DUR_N -> Costo_N_Corto [label="No"];
    Costo_N_Largo -> Actualizar_Cuenta;
    Costo_N_Corto -> Actualizar_Cuenta;

    // --- Flujo de re-alimentación (Loop) ---
    Actualizar_Cuenta -> Leer_Datos_2;
    Leer_Datos_2 -> Loop_Cond; // Vuelve a la condición
}