digraph G {
    rankdir=TB;

    inicio [shape=ellipse, label="Inicio"];
    leerCapacidad [shape=parallelogram, label="Leer la capacidad del directorio telefónico (capacidad)"];
    leerDatos [shape=parallelogram, label="Leer los nombres y números telefónicos (nombres, telefonos)"];
    leerNombreBuscado [shape=parallelogram, label="Leer un nombre para buscar en el directorio (nombreBuscado)"];
    buscarNombre [shape=diamond, label="Buscar el nombre en el directorio"];
    encontrado [shape=diamond, label="¿El nombre fue encontrado?"];
    imprimirResultado [shape=box, label="Imprimir el número telefónico o mensaje de no encontrado"];
    agregarNombre [shape=diamond, label="Agregar el nombre y número al directorio"];
    imprimirDirectorioLleno [shape=box, label="Imprimir mensaje de directorio lleno"];
    fin [shape=ellipse, label="Fin"];

    inicio -> leerCapacidad;
    leerCapacidad -> leerDatos;
    leerDatos -> leerNombreBuscado;
    leerNombreBuscado -> buscarNombre;
    buscarNombre -> encontrado;
    encontrado -> imprimirResultado [label="si", tailport=e, headport=n];
    encontrado -> agregarNombre [label="no", tailport=s, headport=w];
    agregarNombre -> fin [label="si", tailport=s, headport=n];
    buscarNombre -> imprimirDirectorioLleno [label="no", tailport=e, headport=n];
    imprimirDirectorioLleno -> fin;

    leerDatos -> for [label="para i = 0 hasta capacidad - 1", tailport=s, headport=n];
    for -> leerNombre [label="Leer el nombre en la posición i (nombre[i])"];
    leerNombre -> leerTelefono [label="Leer el teléfono en la posición i (telefonos[i])"];
    leerTelefono -> endfor;
    leerNombreBuscado -> for2 [label="para i = 0 hasta capacidad - 1", tailport=s, headport=n];
    for2 -> compararNombres [label="¿nombreBuscado = nombre[i]?", tailport=e, headport=n];
    compararNombres -> endfor2 [label="no", tailport=s, headport=n];
    compararNombres -> encontrado [label="si", tailport=e, headport=n];
    endfor2 -> imprimirNoEncontrado [label="Fin del ciclo", tailport=s, headport=n];
    imprimirNoEncontrado -> agregarNombre [label="Ingresar nuevo nombre y teléfono", tailport=s, headport=w];
}
