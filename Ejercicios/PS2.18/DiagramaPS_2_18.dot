digraph LlamadaTelefonica {
    // Configuración visual
    rankdir=TB;
    node [fontname="Arial", fontsize=12];
    edge [fontsize=10];

    // Nodos Principales
    Inicio [label="INICIO", shape=ellipse];
    Entrada [label="CLAVE, NUMIN", shape=parallelogram];
    
    // Selector de Zona
    Selector [label="CLAVE", shape=hexagon];

    // Asignación de precios según la tabla
    // P1 = Precio primeros 3 min
    // P2 = Precio minuto adicional
    Caso12 [label="P1 ← 2.0\nP2 ← 1.5", shape=box];
    Caso15 [label="P1 ← 2.2\nP2 ← 1.8", shape=box];
    Caso18 [label="P1 ← 4.5\nP2 ← 3.5", shape=box];
    Caso19 [label="P1 ← 3.5\nP2 ← 2.7", shape=box];
    Caso23 [label="P1 ← 6.0\nP2 ← 4.6", shape=box];
    Caso25 [label="P1 ← 6.0\nP2 ← 4.6", shape=box];
    Caso29 [label="P1 ← 5.0\nP2 ← 3.9", shape=box];
    
    // Caso de error
    Error [label="\"ERROR EN CLAVE\"", shape=note];

    // Decisión de tiempo (más de 3 minutos o no)
    DecisionTiempo [label="NUMIN > 3", shape=diamond];

    // Cálculos del costo
    // Si dura más de 3 min: (3 * PrecioBase) + (MinutosExtra * PrecioExtra)
    CalcLarga [label="COSTO ← (3 * P1) + \n((NUMIN - 3) * P2)", shape=box];
    
    // Si dura 3 min o menos: Minutos * PrecioBase
    CalcCorta [label="COSTO ← NUMIN * P1", shape=box];

    // Salida
    Salida [label="COSTO", shape=note];
    Fin [label="FIN", shape=ellipse];

    // --- CONEXIONES ---
    Inicio -> Entrada;
    Entrada -> Selector;

    // Conexiones del Selector (Casos)
    Selector -> Caso12 [label="12"];
    Selector -> Caso15 [label="15"];
    Selector -> Caso18 [label="18"];
    Selector -> Caso19 [label="19"];
    Selector -> Caso23 [label="23"];
    Selector -> Caso25 [label="25"];
    Selector -> Caso29 [label="29"];
    Selector -> Error [label="Otro"];

    // Si es error, termina
    Error -> Fin;

    // Unir todos los casos válidos hacia la decisión de tiempo
    Caso12 -> DecisionTiempo;
    Caso15 -> DecisionTiempo;
    Caso18 -> DecisionTiempo;
    Caso19 -> DecisionTiempo;
    Caso23 -> DecisionTiempo;
    Caso25 -> DecisionTiempo;
    Caso29 -> DecisionTiempo;

    // Lógica del cálculo final
    DecisionTiempo -> CalcLarga [label="Si"];
    DecisionTiempo -> CalcCorta [label="No"];

    // Unir cálculos a la salida
    CalcLarga -> Salida;
    CalcCorta -> Salida;

    Salida -> Fin;
}