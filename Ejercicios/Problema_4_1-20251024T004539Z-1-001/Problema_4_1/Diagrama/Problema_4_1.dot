digraph Problema_4_1 {
  Inicio [shape=ellipse, label="Inicio", style="filled"];
  IngresoValorArray [shape=box, label="'Ingresar la cantidad de valores'"];
    Ingreso [shape=parallelogram, label="N"];
  Condicion [shape=diamond, label="1 <=  N <= 500"];
  Bucle [shape=diamond, label="1 <= N"];
  CreacionArray [shape=box, label="I=1"];
  asignacionI [shape=box, label="I=1"];
   Acumulador [shape=box, label="I=I+1"];
  BucleAsignacion [shape=box, label="'Ingresa valores',I"];
  array [shape=box, label="VEC[I]"];
  array2 [shape=box, label="VEC[I]"];

   REPET2 [shape=box, label="REPET=VEC[I]"];
   Acumulador2 [shape=box, label="I=I+1"];


  Condicion2 [shape=diamond, label="1 <= N"];
   Condicion3 [shape=diamond, label="I<=N y
    REPET=VEC[I] "];
  

   lista [shape=box, label="Lista de numeros sin repeticiones"];
  ImpresionMensaje [shape=box, label="'El numero de elementos del arreglo es incorrecto '"];
  Fin [shape=ellipse, label="Fin"];
  B [shape=invhouse, label="B"];
  A [shape=invhouse, label="A"];

  Inicio -> IngresoValorArray;
  IngresoValorArray -> Ingreso;
  Ingreso->Condicion
  Condicion -> CreacionArray    [label="Si", tailport=e, headport=n];
  Condicion -> ImpresionMensaje [label="No", tailport=w, headport=n];

  Bucle -> BucleAsignacion   [label="Si", tailport=e, headport=n];
  Bucle -> lista [label="No", tailport=w, headport=n];
  
  Condicion2 -> array2   [label="Si", tailport=e, headport=n];
  Condicion2 -> Fin [label="No", tailport=w, headport=n];
  array2->REPET2
  REPET2->Condicion3
lista->A
A->asignacionI
asignacionI->Condicion2;
Acumulador2 ->Condicion3
Condicion3 -> Acumulador2   [label="Si", tailport=e, headport=n];
Condicion3 -> Condicion2 [label="No", tailport=w, headport=s];


  CreacionArray -> Bucle;
  BucleAsignacion->array
  array->Acumulador
  Acumulador->Bucle
  ImpresionMensaje -> B;
  B->Fin
}
