public class TestAnalizadorSueldos {
    public static void main(String[] args) {
        AnalizadorSueldos as = new AnalizadorSueldos();
        // Promedio = (10+20+30+100) / 4 = 40
        // Sueldos > 40: Solo el 100 (1 sueldo)
        double[] sueldos = {10.0, 20.0, 30.0, 100.0};
        
        int resultado = as.contarSueldosSobrePromedio(sueldos);
        
        if (resultado == 1) {
