public class TestProcesadorFunciones {
    public static void main(String[] args) {
        ProcesadorFunciones pf = new ProcesadorFunciones();
        boolean paso = true;

        // Case 1: 100 * v
        if (pf.calcularValor(1, 5) != 500.0) paso = false;

        // Case 2: 100 ^ v
        if (pf.calcularValor(2, 2) != 10000.0) paso = false;

        // Case 3: 100 / v
        if (pf.calcularValor(3, 4) != 25.0) paso = false;

        // Default: 0.0
        if (pf.calcularValor(99, 5) != 0.0) paso = false;

        if (paso) System.out.println("✅ Test ProcesadorFunciones PASÓ");
        else System.out.println("❌ Test ProcesadorFunciones FALLÓ");
    }
}