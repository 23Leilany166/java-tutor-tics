public class TestFabrica {
    public static void main(String[] args) {
        double[][] prod = new double[12][10];
        double[] costos = new double[10];
        
        // Producto 0: 10 unidades cada mes (120 total), costo 2.0
        for(int i=0; i<12; i++) prod[i][0] = 10.0;
        costos[0] = 2.0;
        
        Fabrica fabrica = new Fabrica(prod, costos);
        double[] reporte = fabrica.getCostoAnualPorProducto();
        
        // Esperado: 120 unidades * 2.0 costo = 240.0
        if (Math.abs(reporte[0] - 240.0) < 0.01) {
            System.out.println("✅ Test Fabrica PASÓ");
        } else {
            System.out.println("❌ Test Fabrica FALLÓ");
        }
    }
}