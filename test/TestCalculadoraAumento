public class TestCalculadoraAumento {
    public static void main(String[] args) {
        CalculadoraAumento calc = new CalculadoraAumento();

        // Caso 1: Sueldo < 1000 (Aumento 15%)
        double caso1 = calc.calcularNuevoSueldo(800.0);
        double esperado1 = 800.0 * 1.15; // 920.0

        // Caso 2: Sueldo >= 1000 (Aumento 12%)
        double caso2 = calc.calcularNuevoSueldo(1000.0);
        double esperado2 = 1000.0 * 1.12; // 1120.0

        if (Math.abs(caso1 - esperado1) < 0.01 && Math.abs(caso2 - esperado2) < 0.01) {
            System.out.println("✅ Test CalculadoraAumento PASÓ");
        } else {
            System.out.println("❌ Test CalculadoraAumento FALLÓ");
        }
    }
}