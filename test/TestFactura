public class TestFactura {
    public static void main(String[] args) {
        Factura f = new Factura();
        // Item: clave 1, ramo "Test", cantidad 2, precio 50.0 -> Total 100.0
        f.agregarItem(new ItemFactura(1, "Test", 2, 50.0));
        // Item: clave 2, ramo "Test", cantidad 1, precio 30.0 -> Total 30.0
        f.agregarItem(new ItemFactura(2, "Test", 1, 30.0));
        
        if (Math.abs(f.getGranTotal() - 130.0) < 0.01) {
             System.out.println("✅ Test Factura PASÓ");
        } else {
             System.out.println("❌ Test Factura FALLÓ");
        }
    }
}