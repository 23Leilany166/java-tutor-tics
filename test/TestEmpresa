        Empresa emp = new Empresa();
        // Setup manual para test (asumiendo métodos para agregar o acceso a listas)
        // Agregamos un empleado "Juan"
        emp.altaEmpleado(new Empleado("Juan", 1, 5, 20000));
        
        // Redirigir salida para capturar el print de buscarInfoEmpleado
        ByteArrayOutputStream outContent = new ByteArrayOutputStream();
