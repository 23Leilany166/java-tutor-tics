digraph Calcular_Costo_Llamadas {
  Inicio [
    shape=ellipse,
    label="Inicio", 
    fillcolor="#FF0000", 
    style="filled"
  ];
  Leer_TIPO_DUR [
    shape=parallelogram,
    label="Leer TIPO, DUR"
  ];
  Inicio -> Leer_TIPO_DUR;

  Subgraph cluster_condicional {
    label="Mientras (TIPO ≠ \"X\") y (DUR ≠ -1)";
    Leer_TIPO_DUR -> Condicional_TIPO_DUR;
    Condicional_TIPO_DUR [
      shape=diamond,
      label="TIPO ≠ \"X\"\nDUR ≠ -1"
    ];
    Leer_TIPO_DUR -> Condicional_TIPO_DUR [label="Sí"];
    Condicional_TIPO_DUR -> Leer_TIPO_DUR [label="No"];

    Subgraph cluster_condicion_I {
      label="Si TIPO = \"I\"";
      Condicional_TIPO_DUR -> Condicional_TIPO_I [label="Sí"];
      Condicional_TIPO_I [
        shape=diamond,
        label="DUR > 3"
      ];
      Condicional_TIPO_DUR -> Condicional_TIPO_I [label="No"];

      Calcular_COSTO_I [
        shape=box,
        label="COSTO = 7.59 + ((DUR - 3) * 3.03)"
      ];
      Calcular_COSTO_I -> Incrementar_CUENTA_I;
      Incrementar_CUENTA_I [
        shape=box,
        label="CUENTA = CUENTA + COSTO"
      ];

      Condicional_TIPO_I -> Calcular_COSTO_I [label="Sí"];
      Condicional_TIPO_I -> Incrementar_CUENTA_I [label="No"];
    }

    Subgraph cluster_condicion_L {
      label="Si TIPO = \"L\"";
      Condicional_TIPO_DUR -> Condicional_TIPO_L [label="Sí"];
      Condicional_TIPO_L [
        shape=diamond,
        label="CL > 50"
      ];
      Condicional_TIPO_DUR -> Condicional_TIPO_L [label="No"];

      Incrementar_CL_L [
        shape=box,
        label="CL = CL + 1"
      ];
      Incrementar_CL_L -> Condicional_Costo_L [label="Sí"];

      Condicional_Costo_L [
        shape=diamond,
        label="CL > 50"
      ];
      Incrementar_CL_L -> Condicional_Costo_L [label="No"];

      Calcular_Costo_L [
        shape=box,
        label="COSTO = 0.60"
      ];
      Calcular_Costo_L -> Incrementar_CUENTA_L;

      Condicional_Costo_L -> Calcular_Costo_L [label="Sí"];
      Condicional_Costo_L -> Incrementar_CUENTA_L [label="No"];
    }

    Subgraph cluster_condicion_N {
      label="Si TIPO = \"N\"";
      Condicional_TIPO_DUR -> Condicional_TIPO_N [label="Sí"];
      Condicional_TIPO_N [
        shape=diamond,
        label="DUR > 3"
      ];
      Condicional_TIPO_DUR -> Condicional_TIPO_N [label="No"];

      Calcular_Costo_N [
        shape=box,
        label="COSTO = 1.20 + ((DUR - 3) * 0.48)"
      ];
      Calcular_Costo_N -> Incrementar_CUENTA_N;

      Condicional_TIPO_N -> Calcular_Costo_N [label="Sí"];
      Condicional_TIPO_N -> Incrementar_CUENTA_N [label="No"];
    }
  }

  Escribir_CUENTA [
    shape=box,
    label="Escribir CUENTA"
  ];

  Leer_TIPO_DUR -> Subgraph cluster_condicional;

  Incrementar_CUENTA_I -> Leer_TIPO_DUR;
  Incrementar_CUENTA_L -> Leer_TIPO_DUR;
  Incrementar_CUENTA_N -> Leer_TIPO_DUR;

  Escribir_CUENTA -> Fin;

  Fin [
    shape=ellipse,
    label="Fin"
  ];
  
  Leer_TIPO_DUR -> Fin [label="TIPO = \"X\"\nDUR = -1"];
}
