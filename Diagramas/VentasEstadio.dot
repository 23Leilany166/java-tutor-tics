digraph G {
    // Configuraciones generales
    node [shape=box, style=rounded];
    rankdir=TB;

    // Estilos de formas de diagrama de flujo
    start_end [shape=oval, label="INICIO"];
    process [shape=box];
    input_output [shape=parallelogram];
    decision [shape=diamond];
    subroutine [shape=box3d];

    // Nodos del diagrama
    n0 [shape=oval, label="INICIO"];
    n1 [shape=box, label="AP1=0\nAP2=0\nAP3=0\nAP4=0\nAP5=0\nRECAU=0"];
    n2 [shape=parallelogram, label="Leer P1, P2, P3, P4, P5"];
    n3 [shape=parallelogram, label="Leer CLAVE, CANT"];
    n4 [shape=diamond, label="CLAVE != -1 Y CANT != -1"];
    
    // Nodos dentro del ciclo (switch/case)
    n5 [shape=diamond, label="CLAVE"];
    
    // Casos del switch
    c1 [shape=box, label="PRE = P1*CANT\nAP1 = AP1 + CANT"];
    c2 [shape=box, label="PRE = P2*CANT\nAP2 = AP2 + CANT"];
    c3 [shape=box, label="PRE = P3*CANT\nAP3 = AP3 + CANT"];
    c4 [shape=box, label="PRE = P4*CANT\nAP4 = AP4 + CANT"];
    c5 [shape=box, label="PRE = P5*CANT\nAP5 = AP5 + CANT"];
    c_def [shape=box, label="Imprimir 'Clave Inválida'\nPRE = 0"];
    
    // Punto de unión después del switch
    n6 [shape=circle, label=""]; 
    
    n7 [shape=box, label="RECAU = RECAU + PRE"];
    n8 [shape=parallelogram, label="Leer CLAVE, CANT"];
    n9 [shape=parallelogram, label="Escribir 'CANTIDAD BOLETOS TIPO 1:', AP1\n...\nEscribir 'RECAUDACIÓN DEL ESTADIO:', RECAU"];
    n10 [shape=oval, label="FIN"];

    // Conexiones
    n0 -> n1;
    n1 -> n2;
    n2 -> n3;
    
    // Inicio del ciclo While
    n3 -> n4;

    // Ramificación del ciclo
    n4 -> n5 [label="Si"];
    n4 -> n9 [label="No"];

    // Estructura Switch (Decisión Múltiple)
    n5 -> c1 [label="1"];
    n5 -> c2 [label="2"];
    n5 -> c3 [label="3"];
    n5 -> c4 [label="4"];
    n5 -> c5 [label="5"];
    n5 -> c_def [label="Otro"];

    // Conexión de los casos a la unión (n6)
    c1 -> n6;
    c2 -> n6;
    c3 -> n6;
    c4 -> n6;
    c5 -> n6;
    c_def -> n6; 
    
    // Final del ciclo
    n6 -> n7;
    n7 -> n8;
    n8 -> n4 [label="Repetir"];

    // Finalización del programa
    n9 -> n10;
}