digraph AnalisisCalificaciones {
    // Configuración general del gráfico
    rankdir=TB; // Dirección de arriba hacia abajo
    node [shape=box, style=rounded, fontname="Arial"]; // Estilo de nodos por defecto
    edge [fontname="Arial"]; // Estilo de flechas

    // --- Definición de Nodos ---

    Start [label="Inicio", shape=ellipse];
    End [label="Fin", shape=ellipse];

    // Bloque 0: Inicialización
    Init [label="Inicializar Scanner\nNUM_ALUMNOS = 5\nNUM_EXAMENES = 3\ncalificaciones[5][3]"];
    
    // --- Bloque 1: Lectura de Calificaciones ---
    InputHeader [label="Imprimir 'Ingrese calificaciones...'"];
    
    // Loop i (Alumnos)
    LoopAlumnosInput_Check [label="i = 0\ni < NUM_ALUMNOS", shape=diamond];
    InputAlumnoHeader [label="Imprimir 'Alumno ' + (i+1)"];
    
    // Loop j (Exámenes)
    LoopExamenesInput_Check [label="j = 0\nj < NUM_EXAMENES", shape=diamond];
    InputExamenHeader [label="Imprimir 'Examen ' + (j+1)"];
    ReadInput [label="Leer calificaciones[i][j]", shape=parallelogram];
    LoopExamenesInput_Inc [label="j++"];
    
    LoopAlumnosInput_Inc [label="i++"];
    
    // --- Bloque 2: Promedio Examen (a) y Máximo (c) ---
    CalcHeaderA [label="Imprimir '--- Promedio por Examen ---'"];
    InitCalcA [label="Inicializar promedioExamen[]\nmaxPromedioExamen = -1\nindiceMaxExamen = -1"];
    
    // Loop j (Exámenes)
    LoopExamenesCalcA_Check [label="j = 0\nj < NUM_EXAMENES", shape=diamond];
    InitSumaExamen [label="sumaExamen = 0"];
    
    // Loop i (Alumnos)
    LoopAlumnosCalcA_Check [label="i = 0\ni < NUM_ALUMNOS", shape=diamond];
    CalcSumaExamen [label="sumaExamen += calificaciones[i][j]"];
    LoopAlumnosCalcA_Inc [label="i++"];
    
    // Continuación Loop j
    CalcPromedioExamen [label="promedioExamen[j] = sumaExamen / NUM_ALUMNOS"];
    PrintPromedioExamen [label="Imprimir promedioExamen[j]", shape=parallelogram];
    CheckMaxExamen [label="promedioExamen[j] > maxPromedioExamen", shape=diamond];
    UpdateMaxExamen [label="maxPromedioExamen = promedioExamen[j]\nindiceMaxExamen = j"];
    PostCheckMax [label="Continuar", shape=point, width=0, height=0]; // Nodo de unión
    LoopExamenesCalcA_Inc [label="j++"];
    
    // --- Bloque 3: Promedio Alumno (b) ---
    CalcHeaderB [label="Imprimir '--- Promedio por Alumno ---'"];
    InitCalcB [label="Inicializar promedioAlumno[]"];
    
    // Loop i (Alumnos)
    LoopAlumnosCalcB_Check [label="i = 0\ni < NUM_ALUMNOS", shape=diamond];
    InitSumaAlumno [label="sumaAlumno = 0"];
    
    // Loop j (Exámenes)
    LoopExamenesCalcB_Check [label="j = 0\nj < NUM_EXAMENES", shape=diamond];
    CalcSumaAlumno [label="sumaAlumno += calificaciones[i][j]"];
    LoopExamenesCalcB_Inc [label="j++"];
    
    // Continuación Loop i
    CalcPromedioAlumno [label="promedioAlumno[i] = sumaAlumno / NUM_EXAMENES"];
    PrintPromedioAlumno [label="Imprimir promedioAlumno[i]", shape=parallelogram];
    LoopAlumnosCalcB_Inc [label="i++"];
    
    // --- Bloque 4: Imprimir Máximo (c) ---
    CalcHeaderC [label="Imprimir '--- Examen con Mayor Promedio ---'"];
    CheckMaxIndex [label="indiceMaxExamen != -1", shape=diamond];
    PrintMaxExamen [label="Imprimir Examen (indiceMaxExamen+1)\ny maxPromedioExamen", shape=parallelogram];
    PostCheckPrint [label="Continuar", shape=point, width=0, height=0]; // Nodo de unión

    // --- Bloque 5: Cierre ---
    CloseScanner [label="scanner.close()"];

    // --- Conexiones (Edges) ---
    Start -> Init;
    Init -> InputHeader;

    // Conexiones Bloque 1: Input
    InputHeader -> LoopAlumnosInput_Check;
    LoopAlumnosInput_Check -> InputAlumnoHeader [label="Sí (i < N)"];
    InputAlumnoHeader -> LoopExamenesInput_Check;
    
    LoopExamenesInput_Check -> InputExamenHeader [label="Sí (j < M)"];
    InputExamenHeader -> ReadInput;
    ReadInput -> LoopExamenesInput_Inc;
    LoopExamenesInput_Inc -> LoopExamenesInput_Check; // Cierre Loop j
    
    LoopExamenesInput_Check -> LoopAlumnosInput_Inc [label="No (j >= M)"]; // Salida Loop j
    LoopAlumnosInput_Inc -> LoopAlumnosInput_Check; // Cierre Loop i
    
    LoopAlumnosInput_Check -> CalcHeaderA [label="No (i >= N)"]; // Salida Loop i

    // Conexiones Bloque 2: Calc A (Examen)
    CalcHeaderA -> InitCalcA;
    InitCalcA -> LoopExamenesCalcA_Check;
    
    LoopExamenesCalcA_Check -> InitSumaExamen [label="Sí (j < M)"];
    InitSumaExamen -> LoopAlumnosCalcA_Check;
    
    LoopAlumnosCalcA_Check -> CalcSumaExamen [label="Sí (i < N)"];
    CalcSumaExamen -> LoopAlumnosCalcA_Inc;
    LoopAlumnosCalcA_Inc -> LoopAlumnosCalcA_Check; // Cierre Loop i (interno)
    
    LoopAlumnosCalcA_Check -> CalcPromedioExamen [label="No (i >= N)"]; // Salida Loop i (interno)
    CalcPromedioExamen -> PrintPromedioExamen;
    PrintPromedioExamen -> CheckMaxExamen;
    CheckMaxExamen -> UpdateMaxExamen [label="Sí"];
    UpdateMaxExamen -> PostCheckMax;
    CheckMaxExamen -> PostCheckMax [label="No"];
    PostCheckMax -> LoopExamenesCalcA_Inc;
    LoopExamenesCalcA_Inc -> LoopExamenesCalcA_Check; // Cierre Loop j (externo)
    
    LoopExamenesCalcA_Check -> CalcHeaderB [label="No (j >= M)"]; // Salida Loop j (externo)

    // Conexiones Bloque 3: Calc B (Alumno)
    CalcHeaderB -> InitCalcB;
    InitCalcB -> LoopAlumnosCalcB_Check;
    
    LoopAlumnosCalcB_Check -> InitSumaAlumno [label="Sí (i < N)"];
    InitSumaAlumno -> LoopExamenesCalcB_Check;
    
    LoopExamenesCalcB_Check -> CalcSumaAlumno [label="Sí (j < M)"];
    CalcSumaAlumno -> LoopExamenesCalcB_Inc;
    LoopExamenesCalcB_Inc -> LoopExamenesCalcB_Check; // Cierre Loop j (interno)
    
    LoopExamenesCalcB_Check -> CalcPromedioAlumno [label="No (j >= M)"]; // Salida Loop j (interno)
    CalcPromedioAlumno -> PrintPromedioAlumno;
    PrintPromedioAlumno -> LoopAlumnosCalcB_Inc;
    LoopAlumnosCalcB_Inc -> LoopAlumnosCalcB_Check; // Cierre Loop i (externo)
    
    LoopAlumnosCalcB_Check -> CalcHeaderC [label="No (i >= N)"]; // Salida Loop i (externo)

    // Conexiones Bloque 4: Print Max
    CalcHeaderC -> CheckMaxIndex;
    CheckMaxIndex -> PrintMaxExamen [label="Sí"];
    PrintMaxExamen -> PostCheckPrint;
    CheckMaxIndex -> PostCheckPrint [label="No"];

    // Conexiones Bloque 5: Cierre
    PostCheckPrint -> CloseScanner;
    CloseScanner -> End;
}