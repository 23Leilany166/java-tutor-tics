digraph PS_3_42_InvertirNumero {
    // Configuración general
    rankdir=TB;
    node [shape=box, fontname="Helvetica", style=filled, color=white];
    edge [fontname="Helvetica"];

    // Nodos principales
    start [label="Inicio", shape=ellipse];
    init [label="Iniciar Scanner\nDeclarar n\nint x = 0\nint k = 0"];
    read_n [label="Leer n", shape=parallelogram];
    
    if_valid [label="¿n > 0?", shape=diamond];
    
    // Ruta de error
    print_error [label="Imprimir 'El número no es válido'", shape=parallelogram];
    
    // Nodos del bucle (agrupados)
    subgraph cluster_loop {
        label = "Bucle While (Invertir)";
        style=filled;
        color=lightgrey;

        loop_cond [label="¿n > 0?", shape=diamond];
        
        // Pasos dentro del bucle
        calc_k [label="k = n % 10"];
        calc_x [label="x = x * 10 + k"];
        calc_n [label="n = n / 10"];
        
        // --- Flujo del bucle ---
        loop_cond -> calc_k [label="Sí"];
        calc_k -> calc_x;
        calc_x -> calc_n;
        calc_n -> loop_cond [style=dashed];
    }
    
    // Nodos finales
    print_result [label="Imprimir resultados\n(k, x, n)", shape=parallelogram];
    close_scanner [label="scanner.close()"];
    end [label="Fin", shape=ellipse];

    // --- Definición del Flujo ---
    start -> init -> read_n -> if_valid;

    // Flujo de error
    if_valid -> print_error [label="No"];
    print_error -> close_scanner;

    // Flujo principal (con bucle)
    if_valid -> loop_cond [label="Sí"];
    loop_cond -> print_result [label="No"]; // Salida del bucle
    
    print_result -> close_scanner;
    close_scanner -> end;
}