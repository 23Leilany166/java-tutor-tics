digraph ContarCeros {
    // Configuración general del gráfico
    rankdir=TB; // Dirección de arriba hacia abajo
    node [shape=box, style=rounded, fontname="Arial"]; // Estilo de nodos por defecto
    edge [fontname="Arial"]; // Estilo de flechas

    // --- Definición de Nodos ---

    Start [label="Inicio", shape=ellipse];
    End [label="Fin", shape=ellipse];

    // Bloque 1: Inicialización y Entradas
    InitScanner [label="Inicializar Scanner"];
    InputNHeader [label="Imprimir '¿Cuántos números va a ingresar?'"];
    ReadN [label="Leer n", shape=parallelogram];
    InitCuecer [label="cuecer = 0"];
    InputNumsHeader [label="Imprimir 'Ingrese los n números:'"];

    // Bloque 2: Bucle For
    LoopCheck [label="i = 1\ni <= n", shape=diamond];
    
    // Dentro del bucle
    ReadNum [label="Leer num", shape=parallelogram];
    CheckNumZero [label="num == 0", shape=diamond];
    IncrementCuecer [label="cuecer++"];
    LoopInc [label="i++"];
    PostCheck [label="", shape=point]; // Nodo de unión

    // Bloque 3: Salida y Cierre
    PrintResult [label="Imprimir 'Cantidad de ceros: ' + cuecer", shape=parallelogram];
    CloseScanner [label="scanner.close()"];

    // --- Conexiones (Edges) ---

    Start -> InitScanner;
    InitScanner -> InputNHeader;
    InputNHeader -> ReadN;
    ReadN -> InitCuecer;
    InitCuecer -> InputNumsHeader;
    InputNumsHeader -> LoopCheck;

    // Conexiones del bucle
    LoopCheck -> ReadNum [label="Sí (i <= n)"];
    ReadNum -> CheckNumZero;
    CheckNumZero -> IncrementCuecer [label="Sí"];
    IncrementCuecer -> PostCheck;
    CheckNumZero -> PostCheck [label="No"];
    PostCheck -> LoopInc;
    LoopInc -> LoopCheck; // Regreso al inicio del bucle

    // Salida del bucle
    LoopCheck -> PrintResult [label="No (i > n)"];
    PrintResult -> CloseScanner;
    CloseScanner -> End;
}