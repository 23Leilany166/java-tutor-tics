digraph BisiestosPerfectos {
    // Configuración general
    rankdir=TB; // De arriba hacia abajo
    node [shape=box, style=rounded, fontname="Arial"];
    edge [fontname="Arial"];
    
    // --- Subgrafo: main ---
    subgraph cluster_main {
        label = "main()";
        style=dashed;
        
        Main_Start [label="Inicio main", shape=ellipse];
        Main_Init [label="bisiestosPerfectos = new ArrayList<>()\nlimiteSuperior = 2020"];
        
        // Loop principal 'anio'
        Main_Loop_Check [label="anio = 1\nanio <= limiteSuperior", shape=diamond];
        
        // Dentro del loop
        Main_Call_Bisiesto [label="Call esBisiesto(anio)", shape=box, peripheries=2];
        Main_Call_Perfecto [label="Call esPerfecto(anio)", shape=box, peripheries=2];
        Main_Check_Ambas [label="esBisiesto(anio) && esPerfecto(anio)", shape=diamond];
        Main_Add_ToList [label="bisiestosPerfectos.add(anio)"];
        Main_Loop_End_Point [label="", shape=point]; // Nodo de unión
        Main_Loop_Inc [label="anio++"];
            
        // Después del loop
        Main_Print_Header [label="Imprimir 'Años bisiestos y perfectos...'", shape=parallelogram];
        Main_Check_Empty [label="bisiestosPerfectos.isEmpty()", shape=diamond];
        Main_Print_Empty [label="Imprimir 'No se encontraron...'", shape=parallelogram];
        Main_Print_List [label="Imprimir bisiestosPerfectos", shape=parallelogram];
        Main_Join_Print [label="", shape=point]; // Nodo de unión
            
        Main_End [label="Fin main", shape=ellipse];
            
        // --- Flujo de main ---
        Main_Start -> Main_Init;
        Main_Init -> Main_Loop_Check;
        
        // Flujo del loop 'anio'
        Main_Loop_Check -> Main_Call_Bisiesto [label="Sí (anio <= 2020)"];
        Main_Call_Bisiesto -> Main_Call_Perfecto;
        Main_Call_Perfecto -> Main_Check_Ambas;
        Main_Check_Ambas -> Main_Add_ToList [label="Sí (Ambas True)"];
        Main_Add_ToList -> Main_Loop_End_Point;
        Main_Check_Ambas -> Main_Loop_End_Point [label="No"];
        Main_Loop_End_Point -> Main_Loop_Inc;
        Main_Loop_Inc -> Main_Loop_Check;

        // Salida del loop 'anio'
        Main_Loop_Check -> Main_Print_Header [label="No (anio > 2020)"]; 
        Main_Print_Header -> Main_Check_Empty;
        Main_Check_Empty -> Main_Print_Empty [label="Sí (Vacía)"];
        Main_Check_Empty -> Main_Print_List [label="No (No vacía)"];
        Main_Print_Empty -> Main_Join_Print;
        Main_Print_List -> Main_Join_Print;
        Main_Join_Print -> Main_End;
    }

    // --- Subgrafo: esBisiesto ---
    subgraph cluster_esBisiesto {
        label = "esBisiesto(int anio)";
        style=dashed;
        
        Bisiesto_Start [label="Inicio esBisiesto", shape=ellipse];
        Bisiesto_Check1 [label="anio % 4 == 0", shape=diamond];
        Bisiesto_Check2 [label="anio % 100 != 0", shape=diamond];
        Bisiesto_Check3 [label="anio % 400 == 0", shape=diamond];
        Bisiesto_Return_True [label="return true", shape=ellipse];
        Bisiesto_Return_False [label="return false", shape=ellipse];

        // Flujo de (A && B) || C
        Bisiesto_Start -> Bisiesto_Check1;
        Bisiesto_Check1 -> Bisiesto_Check2 [label="Sí (A=T)"];
        Bisiesto_Check1 -> Bisiesto_Check3 [label="No (A=F)"]; // Si A es F, checar C
        
        Bisiesto_Check2 -> Bisiesto_Return_True [label="Sí (B=T)"]; // A=T y B=T -> True
        Bisiesto_Check2 -> Bisiesto_Check3 [label="No (B=F)"]; // Si A=T y B=F, checar C
        
        Bisiesto_Check3 -> Bisiesto_Return_True [label="Sí (C=T)"];
        Bisiesto_Check3 -> Bisiesto_Return_False [label="No (C=F)"];
    }
    
    // --- Subgrafo: esPerfecto ---
    subgraph cluster_esPerfecto {
        label = "esPerfecto(int numero)";
        style=dashed;

        Perfecto_Start [label="Inicio esPerfecto", shape=ellipse];
        Perfecto_Check_Num [label="numero <= 1", shape=diamond];
        Perfecto_Return_False_1 [label="return false", shape=ellipse];
        Perfecto_Init_Suma [label="sumaDivisores = 1"];
        
        // Loop 'i'
        Perfecto_Loop_Check [label="i = 2\ni <= numero / 2", shape=diamond];
        
        // Dentro del loop 'i'
        Perfecto_Check_Divisor [label="numero % i == 0", shape=diamond];
        Perfecto_Add_Suma [label="sumaDivisores += i"];
        Perfecto_Loop_Inc [label="i++"];

        // Después del loop 'i'
        Perfecto_Check_Final [label="sumaDivisores == numero", shape=diamond];
        Perfecto_Return_True [label="return true", shape=ellipse];
        Perfecto_Return_False_2 [label="return false", shape=ellipse];

        // --- Flujo de esPerfecto ---
        Perfecto_Start -> Perfecto_Check_Num;
        Perfecto_Check_Num -> Perfecto_Return_False_1 [label="Sí"];
        Perfecto_Check_Num -> Perfecto_Init_Suma [label="No"];
        Perfecto_Init_Suma -> Perfecto_Loop_Check;

        // Flujo del loop 'i'
        Perfecto_Loop_Check -> Perfecto_Check_Divisor [label="Sí (i <= num/2)"];
        Perfecto_Check_Divisor -> Perfecto_Add_Suma [label="Sí (es divisor)"];
        Perfecto_Add_Suma -> Perfecto_Loop_Inc;
        Perfecto_Check_Divisor -> Perfecto_Loop_Inc [label="No (no es divisor)"];
        Perfecto_Loop_Inc -> Perfecto_Loop_Check;

        // Salida del loop 'i'
        Perfecto_Loop_Check -> Perfecto_Check_Final [label="No (i > num/2)"];
        Perfecto_Check_Final -> Perfecto_Return_True [label="Sí (Suma == Num)"];
        Perfecto_Check_Final -> Perfecto_Return_False_2 [label="No (Suma != Num)"];
    }
}