digraph SeguimientoVariables {
    // Configuración general
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial"];
    edge [fontname="Arial"];

    // --- Definición de Nodos ---
    Start [label="Inicio", shape=ellipse];
    End [label="Fin", shape=ellipse];

    // Bloque 1: Inicialización y Asignaciones Secuenciales
    Init [label="Inicializar i=0, acum=0, j=0, rea=0.0, sum=0.0, car=' ', band=false"];
    Step1_2 [label="i = i + 1"];
    Step3 [label="acum = 0"];
    Step4 [label="j = (5^2) / 3 (Div. Entera)"];
    Step5 [label="car = 'a'"];

    // Bloque 2: Paso 6 (División condicional)
    CheckDiv0_6 [label="i != 0", shape=diamond];
    Step6_Calc [label="acum = j / i (Div. Entera)"];
    Step6_Error [label="Imprimir Error: Div. por cero"];
    Join6 [label="", shape=point];

    // Bloque 3: Asignaciones Secuenciales
    Step7 [label="rea = acum / 3.0"];
    Step8 [label="band = (8 > 5) && (15 < 2^3)"];

    // Bloque 4: Paso 9 (División condicional)
    CheckDiv0_9 [label="j != 0", shape=diamond];
    Step9_Calc [label="sum = acum * 5.0 / j^2"];
    Step9_Error [label="Imprimir Error: Div. por cero (j=0)"];
    Join9 [label="", shape=point];

    // Bloque 5: Asignaciones Secuenciales Finales
    Step10 [label="i = i * 3"];
    Step11 [label="rea = rea / 5.0"];
    Step12 [label="band = band || (i == j)"];

    // Bloque 6: Errores de Tipos (Solo se imprime advertencia en el runtime)
    Step13 [label="Imprimir Advertencia: Error de tipo (double -> int)"];
    Step14 [label="Imprimir Advertencia: Error de tipo (int -> char)"];
    
    FinalOutput [label="Imprimir Valores Finales", shape=parallelogram];

    // --- Conexiones (Edges) ---
    Start -> Init;
    Init -> Step1_2;
    Step1_2 -> Step3;
    Step3 -> Step4;
    Step4 -> Step5;
    Step5 -> CheckDiv0_6;

    // Flujo Paso 6
    CheckDiv0_6 -> Step6_Calc [label="Sí"];
    CheckDiv0_6 -> Step6_Error [label="No"];
    Step6_Calc -> Join6;
    Step6_Error -> Join6;
    Join6 -> Step7;

    // Continuación y Paso 9
    Step7 -> Step8;
    Step8 -> CheckDiv0_9;

    // Flujo Paso 9
    CheckDiv0_9 -> Step9_Calc [label="Sí"];
    CheckDiv0_9 -> Step9_Error [label="No"];
    Step9_Calc -> Join9;
    Step9_Error -> Join9;
    Join9 -> Step10;

    // Flujo Final
    Step10 -> Step11;
    Step11 -> Step12;
    Step12 -> Step13;
    Step13 -> Step14;
    Step14 -> FinalOutput;
    FinalOutput -> End;
}