digraph TemperaturaGrillo {
    // Configuración general del gráfico
    rankdir=TB; // Dirección de arriba hacia abajo
    node [shape=box, style=rounded, fontname="Arial"]; // Estilo de nodos por defecto
    edge [fontname="Arial"]; // Estilo de flechas

    // --- Definición de Nodos ---

    Start [label="Inicio", shape=ellipse];
    End [label="Fin", shape=ellipse];

    // Bloque 1: Inicialización y Entrada
    InitScanner [label="Inicializar Scanner"];
    InputHeader [label="Imprimir 'Ingrese el número de sonidos por minuto (N):'"];
    ReadN [label="Leer n", shape=parallelogram];

    // Bloque 2: Decisión y Lógica
    CheckNPositive [label="n > 0", shape=diamond];
    
    // Rama 'Sí' (Cálculo)
    CalculateT [label="t = n / 4.0 + 40"];
    PrintResult [label="Imprimir 'Temperatura calculada: ' + t", shape=parallelogram];

    // Rama 'No' (Error)
    PrintError [label="Imprimir 'El número de sonidos debe ser un entero positivo.'", shape=parallelogram];

    // Bloque 3: Cierre
    Join [label="", shape=point]; // Nodo de unión
    CloseScanner [label="scanner.close()"];

    // --- Conexiones (Edges) ---

    Start -> InitScanner;
    InitScanner -> InputHeader;
    InputHeader -> ReadN;
    ReadN -> CheckNPositive;

    // Conexiones de la decisión
    CheckNPositive -> CalculateT [label="Sí"];
    CalculateT -> PrintResult;
    PrintResult -> Join;

    CheckNPositive -> PrintError [label="No"];
    PrintError -> Join;

    // Conexión al final
    Join -> CloseScanner;
    CloseScanner -> End;
}