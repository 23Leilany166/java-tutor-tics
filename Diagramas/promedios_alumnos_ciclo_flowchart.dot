digraph PromediosAlumnosCiclo {
    node [shape=box, style="rounded,filled", fillcolor=lightblue];
    
    // Nodos principales
    inicio [label="Inicio"];
    iniciar_bucle_alumnos [label="i = 1 hasta 35"];
    leer_matricula [label="Leer matrícula"];
    inicializar_suma [label="suma = 0"];
    iniciar_bucle_calificaciones [label="j = 1 hasta 5"];
    leer_calificacion [label="Leer calificación"];
    acumular [label="suma = suma + calificación"];
    fin_bucle_calificaciones [label="j++"];
    calcular_promedio [label="promedio = suma / 5"];
    mostrar_promedio [label="Mostrar promedio"];
    fin_bucle_alumnos [label="i++"];
    fin [label="Fin"];
    
    // Decisiones
    decision_alumnos [shape=diamond, label="¿i ≤ 35?"];
    decision_calificaciones [shape=diamond, label="¿j ≤ 5?"];
    
    // Conexiones
    inicio -> iniciar_bucle_alumnos;
    iniciar_bucle_alumnos -> decision_alumnos;
    
    decision_alumnos -> leer_matricula [label="Sí"];
    decision_alumnos -> fin [label="No"];
    
    leer_matricula -> inicializar_suma;
    inicializar_suma -> iniciar_bucle_calificaciones;
    
    iniciar_bucle_calificaciones -> decision_calificaciones;
    decision_calificaciones -> leer_calificacion [label="Sí"];
    decision_calificaciones -> calcular_promedio [label="No"];
    
    leer_calificacion -> acumular;
    acumular -> fin_bucle_calificaciones;
    fin_bucle_calificaciones -> decision_calificaciones;
    
    calcular_promedio -> mostrar_promedio;
    mostrar_promedio -> fin_bucle_alumnos;
    fin_bucle_alumnos -> decision_alumnos;
}