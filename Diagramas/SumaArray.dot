digraph SumaArray {
    // Configuración general
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial"];
    edge [fontname="Arial"];

    // --- Definición de Nodos ---

    Start [label="Inicio", shape=ellipse];
    End [label="Fin", shape=ellipse];

    // Bloque 1: Inicialización y Declaración
    Init [label="Inicializar Scanner\nN = 5\nvec[5] (double)\nsuma = 0.0"];
    PrintHeader [label="Imprimir 'Ingrese N números reales:'"];

    // Bloque 2: Bucle de Lectura (Llenar el arreglo)
    LoopReadCheck [label="i = 0\ni < N", shape=diamond];
    ReadElement [label="Imprimir 'Elemento (i+1):'\nLeer vec[i]", shape=parallelogram];
    LoopReadInc [label="i++"];

    // Bloque 3: Bucle de Suma (Recorrer el arreglo)
    LoopSumCheck [label="j = 0\nj < N", shape=diamond];
    AccumulateSuma [label="suma += vec[j]"];
    LoopSumInc [label="j++"];

    // Bloque 4: Salida y Cierre
    PrintArray [label="Imprimir Arreglo (vec)", shape=parallelogram];
    PrintSuma [label="Imprimir 'La suma es: ' + suma", shape=parallelogram];
    CloseScanner [label="scanner.close()"];

    // --- Conexiones (Edges) ---

    Start -> Init;
    Init -> PrintHeader;
    PrintHeader -> LoopReadCheck;

    // Flujo Bucle de Lectura
    LoopReadCheck -> ReadElement [label="Sí (i < N)"];
    ReadElement -> LoopReadInc;
    LoopReadInc -> LoopReadCheck;

    // Salida Bucle de Lectura
    LoopReadCheck -> LoopSumCheck [label="No (i >= N)"];

    // Flujo Bucle de Suma
    LoopSumCheck -> AccumulateSuma [label="Sí (j < N)"];
    AccumulateSuma -> LoopSumInc;
    LoopSumInc -> LoopSumCheck;

    // Salida Bucle de Suma
    LoopSumCheck -> PrintArray [label="No (j >= N)"];
    PrintArray -> PrintSuma;
    PrintSuma -> CloseScanner;
    CloseScanner -> End;
}