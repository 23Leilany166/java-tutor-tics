digraph CalcularCotangente {
    // Configuración general del gráfico
    rankdir=TB; // Dirección de arriba hacia abajo
    node [shape=box, style=rounded, fontname="Arial"]; // Estilo de nodos por defecto
    edge [fontname="Arial"]; // Estilo de flechas

    // --- Definición de Nodos ---

    Start [label="Inicio", shape=ellipse];
    End [label="Fin", shape=ellipse];

    // Bloque 1: Inicialización y Entradas
    InitScanner [label="Inicializar Scanner"];
    InputSenoHeader [label="Imprimir 'Ingrese el valor del seno:'"];
    ReadSeno [label="Leer seno", shape=parallelogram];
    InputCosenoHeader [label="Imprimir 'Ingrese el valor del coseno:'"];
    ReadCoseno [label="Leer coseno", shape=parallelogram];

    // Bloque 2: Decisión y Cálculo
    CheckSenoZero [label="seno != 0", shape=diamond];
    
    // Rama 'Sí' (seno no es cero)
    CalculateCot [label="cotangente = coseno / seno"];
    PrintResult [label="Imprimir 'La cotangente es: ...'", shape=parallelogram];

    // Rama 'No' (seno es cero)
    PrintError [label="Imprimir 'La cotangente es indefinida...'", shape=parallelogram];

    // Bloque 3: Cierre
    Join [label="", shape=point]; // Nodo de unión
    CloseScanner [label="scanner.close()"];

    // --- Conexiones (Edges) ---

    Start -> InitScanner;
    InitScanner -> InputSenoHeader;
    InputSenoHeader -> ReadSeno;
    ReadSeno -> InputCosenoHeader;
    InputCosenoHeader -> ReadCoseno;
    ReadCoseno -> CheckSenoZero;

    // Conexiones de la decisión
    CheckSenoZero -> CalculateCot [label="Sí"];
    CalculateCot -> PrintResult;
    PrintResult -> Join;

    CheckSenoZero -> PrintError [label="No"];
    PrintError -> Join;

    // Conexión al final
    Join -> CloseScanner;
    CloseScanner -> End;
}