digraph FlujoCondicional {
  node [shape=box];

  Inicio [shape=ellipse, label="Inicio", style="filled"];
  selector [label="selector = 3"];
  Accion1 [label="Realizando acción 1"];
  Accion2 [label="Realizando acción 2"];
  Accion3 [label="Realizando acción 3"];
  AccionX [label="Realizando acción X"];
  Fin [shape=ellipse, label="Fin"];

  Inicio -> selector;
  selector -> Accion2 [label="3, 4, 5", tailport=s, headport=n];
  selector -> Accion1 [label="1, 2", tailport=w, headport=n];
  selector -> Accion3 [label="default", tailport=e, headport=n];
  Accion1 -> AccionX;
  Accion2 -> AccionX;
  Accion3 -> AccionX;
  AccionX -> Fin;
}
