digraph G {
  rankdir=TB;
  inicio [shape=ellipse, label="Inicio"];

  declaracion [shape=box, label="Declarar e inicializar arreglos y variables"];
  elementos [shape=box, label="elementos = new String[100]"];
  ce [shape=box, label="conductividadElectrica = new double[100]"];
  ct [shape=box, label="conductividadTermica = new double[100]"];
  contadorElementos [shape=box, label="contadorElementos = 0"];
  nombreElemento [shape=box, label="nombreElemento"];
  leerDatos [shape=diamond, label="Leer los datos de los elementos de la tabla periódica?"];
  leerNombre [shape=parallelogram, label="Leer el nombre del elemento (o 'NN' para finalizar)"];
  leerCE [shape=parallelogram, label="Leer la conductividad eléctrica del elemento"];
  leerCT [shape=parallelogram, label="Leer la conductividad térmica del elemento"];
  incrementarContador [shape=box, label="contadorElementos++"];
 calcularConductores [shape=box, label="Calcular los principales elementos conductores de la electricidad y el calor"];
  primerElementoCE [shape=box, label="primerElementoConductorElectricidad = ''"];
  segundoElementoCE [shape=box, label="segundoElementoConductorElectricidad = ''"];
  maxCE [shape=box, label="maxConductividadElectrica = -1"];
  primerElementoCT [shape=box, label="primerElementoConductorCalor = ''"];
  segundoElementoCT [shape=box, label="segundoElementoConductorCalor = ''"];
  maxCT [shape=box, label="maxConductividadTermica = -1"];
  calcularMalConductores [shape=box, label="Calcular los peores elementos conductores de la electricidad y el calor"];
  primerElementoMalCE [shape=box, label="primerElementoMalConductorElectricidad = ''"];
  segundoElementoMalCE [shape=box, label="segundoElementoMalConductorElectricidad = ''"];
  minCE [shape=box, label="minConductividadElectrica = Double.MAX_VALUE"];
  primerElementoMalCT [shape=box, label="primerElementoMalConductorCalor = ''"];
  segundoElementoMalCT [shape=box, label="segundoElementoMalConductorCalor = ''"];
  minCT [shape=box, label="minConductividadTermica = Double.MAX_VALUE"];
  imprimirResultados [shape=box, label="Imprimir los resultados"];
  imprimirCE [shape=box, label="Imprimir principales elementos conductores de la electricidad"];
  imprimirCT [shape=box, label="Imprimir principales elementos conductores del calor"];
  imprimirMalCE [shape=box, label="Imprimir peores elementos conductores de la electricidad"];
  imprimirMalCT [shape=box, label="Imprimir peores elementos conductores del calor"];
  fin [shape=ellipse, label="Fin"];
  inicio -> declaracion;
  declaracion -> elementos;
  elementos->ce->ct->contadorElementos->nombreElemento->leerDatos;
  leerDatos -> leerNombre [label="si", tailport=e, headport=n];
  leerNombre -> leerCE;
  leerCE -> leerCT;
  leerCT -> incrementarContador;
  incrementarContador -> leerNombre;
  leerNombre -> calcularConductores [label="si", tailport=e, headport=n];
  leerNombre -> calcularMalConductores [label="si", tailport=w, headport=n];
  calcularConductores -> primerElementoCE;
  primerElementoCE -> segundoElementoCE;
  segundoElementoCE -> maxCE;
  maxCE -> primerElementoCT;
  primerElementoCT -> segundoElementoCT;
  segundoElementoCT -> maxCT;
  maxCT -> imprimirCE;
  calcularMalConductores -> primerElementoMalCE;
  primerElementoMalCE -> segundoElementoMalCE;
  segundoElementoMalCE -> minCE;
  minCE -> primerElementoMalCT;
  primerElementoMalCT -> segundoElementoMalCT;
  segundoElementoMalCT -> minCT;
  minCT -> imprimirMalCE;
  imprimirCE -> imprimirCT;
  imprimirCT -> imprimirMalCT;
  imprimirMalCT -> imprimirResultados;
  imprimirResultados -> fin;
}
