digraph Problema_3_7_Diagrama {
    node [shape=box];
    start [label="Inicio", shape=ellipse, fillcolor="#40e0d0", style="filled"];
    input [label="Ingrese la cantidad de ventas:", shape=diamond];
    N [label="N = Leer entrada", shape=box];
    I [label="I = 1", shape=box];
    CHI [label="CHI = 0", shape=box];
    MED [label="MED = 0", shape=box];
    GRA [label="GRA = 0", shape=box];
    loop [label="for I = 1 to N", shape=diamond];
    input_venta [label="Ingrese el monto de la venta I:", shape=diamond];
    check_ventas [label="¿V <= 200.0?", shape=diamond];
    check_med [label="¿V < 400.0?", shape=diamond];
    update_chi [label="CHI++", shape=box];
    update_med [label="MED++", shape=box];
    update_gra [label="GRA++", shape=box];
    output [label="Mostrar Ventas chicas: CHI", shape=diamond];
    output_med [label="Mostrar Ventas medianas: MED", shape=diamond];
    output_gra [label="Mostrar Ventas grandes: GRA", shape=diamond];
    end [label="Fin", shape=ellipse, fillcolor="#40e0d0", style="filled"];

    start -> input;
    input -> N;
    N -> I;
    I -> CHI;
    CHI -> MED;
    MED -> GRA;
    GRA -> loop;
    loop -> input_venta [label="Sí"];
    loop -> output [label="No"];
    input_venta -> check_ventas;
    check_ventas -> check_med [label="Sí"];
    check_ventas -> update_gra [label="No"];
    check_med -> update_chi [label="Sí"];
    check_med -> update_med [label="No"];
    update_chi -> update_med;
    update_med -> update_gra;
    update_gra -> loop;
    output -> output_med;
    output_med -> output_gra;
    output_gra -> end;
}
