digraph G {
    rankdir=TB;
    node [shape=rectangle, style=rounded, fontname="Arial"];

    inicio [label="INICIO", shape=ellipse, style=filled, fillcolor=lightgray];
    entrada [label="TIPOENF, EDAD, DIAS"];
    tipo [label="TIPOENF", shape=diamond, width=1.8, height=1];

    t1 [label="COSTOT ← DIAS * 25"];
    t2 [label="COSTOT ← DIAS * 16"];
    t3 [label="COSTOT ← DIAS * 20"];
    t4 [label="COSTOT ← DIAS * 32"];

    condEdad [label="EDAD ≥ 14\nY EDAD ≤ 22", shape=diamond];
    aumento [label="COSTOT ← COSTOT * 1.10"];
    salida [label="\"Costo total:\"\nCOSTOT", shape=parallelogram];
    fin [label="FIN", shape=ellipse, style=filled, fillcolor=lightgray];

    inicio -> entrada -> tipo;

    tipo -> t1 [label="1"];
    tipo -> t2 [label="2"];
    tipo -> t3 [label="3"];
    tipo -> t4 [label="4"];

    t1 -> condEdad;
    t2 -> condEdad;
    t3 -> condEdad;
    t4 -> condEdad;

    condEdad -> aumento [label="Sí"];
    condEdad -> salida [label="No"];
    aumento -> salida -> fin;
}
